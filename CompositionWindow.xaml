<Window x:Class="SimTrade.CompositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SimTrade.Controls"
        Title="Composición"
        Width="680"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/AppIcon.png"
        Background="{StaticResource SurfaceRaisedBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel Margin="0,0,110,0">
                <TextBlock Text="Composición" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Peso de cada posición según su valor de mercado."
                           Margin="0,6,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="Close_Click"
                    Style="{StaticResource SecondaryButton}">
                <ctrl:IconLabel Glyph="Close" Text="Cerrar" />
            </Button>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding Slices}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid Width="260" Height="260" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Data="{Binding Geometry}"
                              Fill="{Binding Fill}"
                              Width="260"
                              Height="260"
                              Stretch="None"
                              Stroke="#110E14"
                              StrokeThickness="2"
                              ToolTip="{Binding ToolTipText}"
                              ToolTipService.InitialShowDelay="200" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ScrollViewer Grid.Column="1" Margin="28,0,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                <ItemsControl ItemsSource="{Binding Slices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="14" Height="14" CornerRadius="4" Background="{Binding Swatch}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ctrl:LogoBadge Symbol="{Binding Symbol}" Size="28" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Symbol}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding WeightText}" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="16,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
