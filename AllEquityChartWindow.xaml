<Window x:Class="SimTrade.AllEquityChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SimTrade.Controls"
        Title="Rendimiento de todos los portafolios"
        Width="980"
        Height="620"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <DockPanel Margin="22,18,22,16">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0">
                <TextBlock Text="Comparar evolución" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SubtitleText"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Text="Rendimiento % de cada portafolio desde su primer día de historial." />
            </StackPanel>
            <TextBlock x:Name="SummaryText"
                       Grid.Column="1"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextAlignment="Right" />
        </Grid>
        <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
            <TextBlock Text="Benchmark"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,0,10,0" />
            <ComboBox x:Name="BenchmarkBox"
                      Width="220"
                      DisplayMemberPath="Label"
                      SelectionChanged="Benchmark_Changed" />
        </DockPanel>
        <TextBlock x:Name="Status"
                   DockPanel.Dock="Top"
                   Margin="0,8,0,12"
                   FontSize="14"
                   Foreground="{StaticResource TextBrush}"
                   TextWrapping="Wrap"
                   Text="Cargando historial…" />
        <ItemsControl x:Name="Legend"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                        <Ellipse Width="10" Height="10" Fill="{Binding Stroke}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ChangeText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding ChangeBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
            <ctrl:MultiLineChart x:Name="Chart" Margin="8,4,8,4" ValueFormat="+0.00;-0.00;0.00" />
        </Border>
    </DockPanel>
</Window>
