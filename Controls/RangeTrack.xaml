<UserControl x:Class="SimTrade.Controls.RangeTrack"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContextChanged="OnDataChanged"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,14,0,0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{Binding LowNativeText}" FontSize="13" />
                <TextBlock Text="{Binding LowMxnText}" Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="{Binding HighNativeText}" FontSize="13" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding HighMxnText}" Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
        <Grid x:Name="Bar" Grid.Row="1" SizeChanged="OnLayoutChanged">
            <Border Height="4"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    CornerRadius="2"
                    Background="{StaticResource LineBrush}" />
            <Ellipse x:Name="Dot"
                     Width="14"
                     Height="14"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Fill="{StaticResource GoldBrush}"
                     IsHitTestVisible="False" />
        </Grid>
        <Canvas x:Name="LabelHost" Grid.Row="2" Height="34" SizeChanged="OnLayoutChanged" ClipToBounds="False">
            <StackPanel x:Name="Label" HorizontalAlignment="Left">
                <TextBlock x:Name="Native" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock x:Name="Mxn" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" />
            </StackPanel>
        </Canvas>
    </Grid>
</UserControl>
