<UserControl x:Class="SimTrade.Controls.IconLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <Viewbox Width="{Binding Size, ElementName=Root}"
                 Height="{Binding Size, ElementName=Root}"
                 Margin="0,0,8,0"
                 VerticalAlignment="Center">
            <Path x:Name="Mark"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
        </Viewbox>
        <TextBlock x:Name="Caption" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="170" />
    </StackPanel>
</UserControl>
