<Window x:Class="SimTrade.PriceRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SimTrade.Controls"
        Title="Rango"
        Width="440"
        SizeToContent="Height"
        MinWidth="380"
        MaxWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="RangeChange" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ChangeTone}" Value="Up">
                    <Setter Property="Foreground" Value="{StaticResource UpBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ChangeTone}" Value="Down">
                    <Setter Property="Foreground" Value="{StaticResource DownBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="RangeBar">
            <ctrl:RangeTrack />
        </DataTemplate>
    </Window.Resources>
    <Border Margin="20" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16">
        <StackPanel>
            <TextBlock x:Name="RangeTitle" FontSize="13" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Margin="0,10,0,0"
                       Text="{Binding Prompt}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolVis}}" />
            <StackPanel Margin="0,12,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <ctrl:LogoBadge DockPanel.Dock="Left" Symbol="{Binding Symbol}" Size="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Symbol}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="PriceNative" Margin="12,0,0,0" FontSize="18" Style="{StaticResource RangeChange}" />
                            <TextBlock Margin="8,0,0,0" FontSize="18" Style="{StaticResource RangeChange}" Text="{Binding ChangeText}" />
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" Text="{Binding CompanyName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PriceMxn" Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </DockPanel>
                <ContentControl x:Name="DayTrack"
                                Margin="0,4,0,0"
                                Content="{Binding DayRange}"
                                ContentTemplate="{StaticResource RangeBar}"
                                Visibility="Collapsed" />
                <ContentControl x:Name="WeekTrack"
                                Margin="0,4,0,0"
                                Content="{Binding WeekRange}"
                                ContentTemplate="{StaticResource RangeBar}"
                                Visibility="Collapsed" />
                <TextBlock x:Name="EmptyText"
                           Margin="0,12,0,0"
                           Text="Sin mínimo o máximo para este símbolo."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
