<Window x:Class="SimTrade.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimTrade"
        Width="860"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <StackPanel Margin="28,22,28,24">
        <Image Source="/Assets/LogoSplash.png"
               Width="760"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock x:Name="VersionText"
                   Margin="0,14,0,0"
                   FontSize="13"
                   Foreground="#8A8A8A"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Desarrollado por Sergio Padrón Arellano"
                   Margin="0,14,0,0"
                   FontSize="14"
                   Foreground="#FFFFFF"
                   HorizontalAlignment="Center" />
        <TextBlock Text="spadron@outlook.com"
                   Margin="0,6,0,0"
                   FontSize="14"
                   Foreground="#D4AF37"
                   HorizontalAlignment="Center" />
        <TextBlock Text="(C) Copyright, all rights reserved (2026)"
                   Margin="0,6,0,0"
                   FontSize="12"
                   Foreground="#9A9A9A"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Window>
